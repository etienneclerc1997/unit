---
// The small chevron at the bottom of a screen that has more below the fold.
// Tapping it scrolls the extra section into view (swiping up does the same).
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button class="fold-hint" aria-label={`Show ${label.toLowerCase()}`}>
  <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M4 9 12 3l8 6" /></svg>
</button>
