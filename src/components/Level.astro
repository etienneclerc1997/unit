---
import Icon from './Icon.astro';
import FoldHint from './FoldHint.astro';
---

<section class="screen" id="screen-level" data-screen="level" aria-label="Level">
  <div class="fold-main">
    <div class="lvl-bar">
      <button class="pill-btn small" id="lvl-zero" aria-label="Calibrate: make this position read zero">Zero</button>
      <button class="pill-btn small quiet" id="lvl-reset" aria-label="Clear calibration">Reset</button>
    </div>

    <!-- One face for level, plumb and flat: a readout between two linear vernier
         dials. Only the text turns to stay upright as the phone rotates. -->
    <div class="lvl-card" id="lvl-card">
      <div class="lvl-face-area">
        <div class="lvl-face" id="lvl-face">
          <div class="lvl-meta"><span class="lamp"></span><span id="lvl-mode">Plumb</span></div>
          <div class="lvl-angle" id="lvl-angle" aria-live="off"></div>
          <div class="lvl-dev" id="lvl-dev">Lean 0.00°</div>
        </div>
      </div>
      <svg class="dial dial-y" id="dial-y" aria-hidden="true"></svg>
      <svg class="dial dial-x" id="dial-x" aria-hidden="true"></svg>
    </div>
    <FoldHint label="Out over" />
  </div>

  <div class="fold-more lvl-more">
    <div class="lvl-offset">
      <div class="offset-head">
        <span class="caps">Out over</span>
        <button class="chip" id="lvl-prec" aria-label="Offset precision">
          <span class="chip-text">1/64</span>
          <Icon name="chevron" />
        </button>
      </div>
      <svg id="chart" aria-label="How far out of level a line gets over distance"></svg>
    </div>
  </div>

  <div class="lvl-gate" id="lvl-gate" hidden>
    <p id="lvl-gate-text"></p>
    <button class="pill-btn" id="lvl-enable" hidden>Enable level</button>
  </div>
</section>

<script>
  import {
    GravityFilter, detectMode, read, calibrate, offsetAt, noCalibration, screenQuarter,
    type Calibration, type LevelMode, type Reading, type Vec3,
  } from '../lib/level';
  import { haptic, load, save, loadPrecision, openPrecisionSheet, prettyHTML, precisionLabel } from '../lib/ui';
  import { toFraction, fractionText } from '../lib/units';
  import { Odometer } from '../lib/odometer';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const SVG = 'http://www.w3.org/2000/svg';

  const screen = $('screen-level');
  const odometer = new Odometer($('lvl-angle'), 2); // degrees off, never past 45
  const modeEl = $('lvl-mode');
  const devEl = $('lvl-dev');
  const gate = $('lvl-gate');
  const gateText = $('lvl-gate-text');
  const enableBtn = $<HTMLButtonElement>('lvl-enable');
  const precChip = $('lvl-prec');

  let cal: Calibration = { ...noCalibration(), ...load<Partial<Calibration>>('levelCal', {}) };
  let precision = loadPrecision('levelPrec', 64);

  function el(name: string, attrs: Record<string, string | number>, parent: Element, text?: string) {
    const n = document.createElementNS(SVG, name);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    if (text !== undefined) n.textContent = text;
    parent.append(n);
    return n;
  }

  const signed = (v: number) => (v < 0 ? `−${-v}` : String(v));

  /* ---------- Linear vernier dials ----------
     Main scale: 1° per division, sliding under a fixed orange index. Vernier:
     10 divisions spanning 9°, so the line that meets a main line gives the tenth. */

  const S = 12; // px per degree
  const DEPTH_X = 64; // thickness of the bottom strip
  const DEPTH_Y = 76; // the side strip is wider: its labels sit beside the ticks

  interface Dial {
    svg: SVGSVGElement;
    scale: Element;
    vernier: Element[];
    vertical: boolean;
    value: number | null;
  }

  function buildDial(svg: SVGSVGElement, vertical: boolean): Dial {
    // Coordinates: `a` runs along the dial (0 = index), `b` across it.
    // Horizontal: main ticks above the baseline; vertical: main ticks to its left.
    const B = vertical ? 42 : 32; // baseline
    const at = (a: number, b: number) => (vertical ? { x: b, y: -a } : { x: a, y: b });
    const line = (a1: number, b1: number, a2: number, b2: number, cls: string, parent: Element) => {
      const p = at(a1, b1);
      const q = at(a2, b2);
      return el('line', { x1: p.x, y1: p.y, x2: q.x, y2: q.y, class: cls }, parent);
    };
    const text = (a: number, b: number, cls: string, s: string, parent: Element) => {
      const p = at(a, b);
      return el('text', { x: p.x, y: p.y, class: cls }, parent, s);
    };

    const scale = el('g', {}, svg);
    for (let v = -90; v <= 90; v++) {
      const len = v % 10 === 0 ? 17 : v % 5 === 0 ? 12 : 7;
      line(v * S, B, v * S, B - len, v % 5 === 0 ? 'tk major' : 'tk', scale);
      if (v % 5 === 0) text(v * S, B - (vertical ? 30 : 25), 'tl', signed(v), scale);
    }
    line(-2000, B, 2000, B, 'base', svg);
    const vernier: Element[] = [];
    for (let k = 0; k <= 10; k++) {
      const a = k * 0.9 * S;
      vernier.push(line(a, B, a, B + (k % 5 === 0 ? 13 : 8), 'vk', svg));
      if (k === 5 || k === 10) text(a, B + 22, 'vl', k === 5 ? '.5' : '1', svg);
    }
    line(0, B - 20, 0, B + 20, 'index', svg);
    return { svg, scale, vernier, vertical, value: null };
  }

  const dialX = buildDial($('dial-x') as unknown as SVGSVGElement, false);
  const dialY = buildDial($('dial-y') as unknown as SVGSVGElement, true);

  function sizeDials() {
    const w = dialX.svg.clientWidth;
    const h = dialY.svg.clientHeight;
    dialX.svg.setAttribute('viewBox', `${-w / 2} 0 ${w} ${DEPTH_X}`);
    dialY.svg.setAttribute('viewBox', `0 ${-h / 2} ${DEPTH_Y} ${h}`);
  }

  const DIAL_TAU = 0.18;
  function setDial(d: Dial, target: number, dt: number) {
    d.value = d.value === null ? target : d.value + (target - d.value) * (1 - Math.exp(-dt / DIAL_TAU));
    const v = Math.max(-90, Math.min(90, d.value));
    d.scale.setAttribute('transform', d.vertical ? `translate(0 ${v * S})` : `translate(${-v * S} 0)`);
    // The vernier line that meets a main line (1–10; on a whole degree it's the index itself).
    const k = Math.round((((v % 1) + 1) % 1) * 10);
    d.vernier.forEach((t, i) => t.classList.toggle('on', i === k && k > 0));
  }

  /* ---------- Turning text upright ---------- */

  let quarter = 0;
  let turn = 0; // accumulated degrees, so 270° → 0° turns the short way

  function setQuarter(q: number) {
    if (q === quarter) return;
    const delta = ((((q - quarter) * 90 + 540) % 360) - 180) as number;
    turn += delta;
    quarter = q;
    screen.style.setProperty('--turn', `${turn}deg`);
  }

  /* ---------- Out over chart ----------
     A view of the line the phone sits on, drawn along the phone's long side.
     On an edge it's seen from the side: the true plumb/level line runs down the
     middle and the real line drifts off it, with a bar at 1′, 2′, 4′ and 8′.
     Lying flat it's seen from above: the line points to the low side. The
     offset scale is fixed and linear (±2″), so nothing rescales or bends;
     anything past it runs off the edge, and the values still read true. */

  const chart = $('chart') as unknown as SVGSVGElement;
  const DISTS: [number, string][] = [[12, '1′'], [24, '2′'], [48, '4′'], [96, '8′']];
  const CAP = 2; // inches either side of the middle
  let W = 340;
  let H = 480;
  const Y0 = 40;
  const y1 = () => H - 40; // room for a value label turned on its side
  const px0 = 44; // left column: distances
  const px1 = () => W - 84; // right column: values
  const cx = () => (px0 + px1()) / 2;
  const half = () => (px1() - px0) / 2;
  const cy = () => (Y0 + y1()) / 2;
  const yAt = (inches: number) => Y0 + (inches / 96) * (y1() - Y0);
  const sx = (offset: number) => (Math.max(-1.08, Math.min(1.08, offset / CAP)) * half());

  const axisG = el('g', {}, chart);
  const clip = el('clipPath', { id: 'chart-clip' }, chart);
  const clipRect = el('rect', {}, clip);
  const plot = el('g', { 'clip-path': 'url(#chart-clip)' }, chart);
  const sideG = el('g', {}, plot);
  const topG = el('g', {}, plot);
  const line = el('line', { class: 'slope' }, plot);
  const marks = el('g', {}, plot);
  const bars = DISTS.map(([d]) => ({
    d,
    bar: el('line', { class: 'bar' }, marks),
    dot: el('circle', { class: 'bar-dot', r: 2.5 }, marks),
    label: el('text', { class: 'bar-val fr' }, chart),
    steps: null as number | null,
  }));

  function drawAxis() {
    axisG.replaceChildren();
    sideG.replaceChildren();
    topG.replaceChildren();
    const x = cx();
    clipRect.setAttribute('x', String(px0 - 4));
    clipRect.setAttribute('y', String(Y0 - 2));
    clipRect.setAttribute('width', String(px1() - px0 + 8));
    clipRect.setAttribute('height', String(y1() - Y0 + 4));

    // Offset scale along the top, both ways from the middle (no negatives: it's a distance off).
    el('line', { x1: px0, y1: Y0, x2: px1(), y2: Y0, class: 'base' }, axisG);
    for (let v = -CAP; v <= CAP; v += 0.5) {
      const labeled = v !== 0 && Number.isInteger(v);
      el('line', { x1: x + sx(v), y1: Y0, x2: x + sx(v), y2: Y0 - (v === 0 || labeled ? 8 : 5), class: 'tk' }, axisG);
      if (labeled) el('text', { x: x + sx(v), y: Y0 - 18, class: 'tl' }, axisG, `${Math.abs(v)}″`);
    }
    // Distance and value columns.
    for (const b of bars) {
      el('text', { x: px0 / 2, y: yAt(b.d), class: 'dist-l' }, axisG, DISTS.find(([d]) => d === b.d)![1]);
      b.label.setAttribute('x', String((px1() + W) / 2));
      b.label.setAttribute('y', String(yAt(b.d)));
    }

    // Side view: the true line down the middle, marked every foot.
    el('line', { x1: x, y1: Y0, x2: x, y2: y1(), class: 'axis' }, sideG);
    for (let f = 1; f <= 8; f++) {
      const len = [1, 2, 4, 8].includes(f) ? 6 : 3;
      el('line', { x1: x - len, y1: yAt(f * 12), x2: x + len, y2: yAt(f * 12), class: 'tk' }, sideG);
    }
    // Top view: crosshair and rings at 1″ and 2″ around the phone.
    el('line', { x1: px0, y1: cy(), x2: px1(), y2: cy(), class: 'base' }, topG);
    el('line', { x1: x, y1: cy() - half(), x2: x, y2: cy() + half(), class: 'base' }, topG);
    for (const v of [1, 2]) el('circle', { cx: x, cy: cy(), r: sx(v), class: 'ring' }, topG);
    el('circle', { cx: x, cy: cy(), r: 3, class: 'center' }, topG);
  }

  function sizeChart() {
    W = chart.clientWidth || 340;
    H = chart.clientHeight || 480;
    chart.setAttribute('viewBox', `0 0 ${W} ${H}`);
    drawAxis();
  }

  const tan = (deg: number) => Math.tan((deg * Math.PI) / 180);

  /**
   * Lay the chart out; called every frame with the slow reading. Edge: `a` is the
   * deviation. Flat: `a`/`b` are the tilts across/along the screen.
   */
  function layoutChart(flat: boolean, a: number, b: number) {
    sideG.toggleAttribute('hidden', flat);
    topG.toggleAttribute('hidden', !flat);
    const x = cx();
    if (!flat) {
      // Tilting the phone counter-clockwise swings the far end to screen-right.
      const t = tan(a);
      line.setAttribute('x1', String(x));
      line.setAttribute('y1', String(Y0));
      line.setAttribute('x2', String(x + sx(t * 96)));
      line.setAttribute('y2', String(y1()));
      for (const m of bars) {
        const bx = x + sx(t * m.d);
        const y = yAt(m.d);
        for (const [k, v] of [['x1', x], ['y1', y], ['x2', bx], ['y2', y]] as const) m.bar.setAttribute(k, String(v));
        m.dot.setAttribute('cx', String(bx));
        m.dot.setAttribute('cy', String(y));
      }
      return;
    }
    // Seen from above, the drop points downhill: away from the raised side (screen y points down).
    const ux = -tan(a);
    const uy = tan(b);
    const y = cy();
    line.setAttribute('x1', String(x));
    line.setAttribute('y1', String(y));
    line.setAttribute('x2', String(x + sx(ux * 96)));
    line.setAttribute('y2', String(y + sx(uy * 96)));
    for (const m of bars) {
      m.bar.setAttribute('x1', String(x));
      m.bar.setAttribute('x2', String(x));
      m.bar.setAttribute('y1', String(y));
      m.bar.setAttribute('y2', String(y));
      m.dot.setAttribute('cx', String(x + sx(ux * m.d)));
      m.dot.setAttribute('cy', String(y + sx(uy * m.d)));
    }
  }

  /** Label text, refreshed on a slow clock with hysteresis. */
  function labelChart(dev: number, force = false) {
    for (const b of bars) {
      const off = Math.abs(offsetAt(dev, b.d));
      const exact = off * precision;
      if (!force && b.steps !== null && Math.abs(exact - b.steps) < 0.65) continue;
      const steps = Math.round(exact);
      b.steps = steps;
      const shownInches = steps / precision;
      const diff = off - shownInches;
      const dir = steps === 0 || Math.abs(diff) * precision < 0.1 ? 0 : diff > 0 ? 1 : -1;
      b.label.textContent = fractionText(toFraction(shownInches, precision)) + '″';
      if (dir) el('tspan', { class: dir > 0 ? 'rd-up' : 'rd-down', dy: -5 }, b.label, dir > 0 ? '+' : '−');
    }
  }

  /* ---------- Sensor ---------- */

  // iOS reports accelerationIncludingGravity with the opposite sign to the spec/Android.
  const IOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const SIGN = IOS ? -1 : 1;

  const filter = new GravityFilter();
  let raw: Vec3 | null = null;
  let lastSample = 0;
  let mode: LevelMode = 'edge';
  let listening = false;
  let active = false;
  let gotData = false;
  let frame = 0;
  let wakeLock: { release(): Promise<void> } | null = null;
  let noDataTimer = 0;

  function onMotion(e: DeviceMotionEvent) {
    const a = e.accelerationIncludingGravity;
    if (!a || a.x === null || a.y === null || a.z === null) return;
    raw = { x: SIGN * a.x, y: SIGN * a.y, z: SIGN * a.z };
    if (!gotData) {
      gotData = true;
      showGate(null);
    }
  }

  function showGate(text: string | null, withButton = false) {
    gate.hidden = text === null;
    screen.classList.toggle('gated', text !== null);
    gateText.textContent = text ?? '';
    enableBtn.hidden = !withButton;
  }

  type PermissionAPI = { requestPermission?: () => Promise<'granted' | 'denied'> };
  const needsPermission = () =>
    typeof (DeviceMotionEvent as unknown as PermissionAPI).requestPermission === 'function';

  function listen() {
    if (listening) return;
    listening = true;
    window.addEventListener('devicemotion', onMotion);
    clearTimeout(noDataTimer);
    noDataTimer = window.setTimeout(() => {
      if (gotData) return;
      // Silence usually means permission is needed (iOS); otherwise there's no sensor.
      if (needsPermission()) showGate('The level uses your phone’s motion sensor.', true);
      else showGate('No motion sensor found. Open this on your phone, over HTTPS.');
    }, 1200);
  }

  function stopListening() {
    listening = false;
    window.removeEventListener('devicemotion', onMotion);
    clearTimeout(noDataTimer);
  }

  function start() {
    if (typeof DeviceMotionEvent === 'undefined') {
      showGate('This browser has no access to motion sensors.');
      return;
    }
    listen();
  }

  enableBtn.addEventListener('click', async () => {
    haptic();
    try {
      const res = await (DeviceMotionEvent as unknown as PermissionAPI).requestPermission!();
      if (res === 'granted') {
        showGate(null);
        stopListening();
        listen();
      } else showGate('Motion access was denied. Allow it in Settings › Safari › Motion & Orientation Access.');
    } catch {
      showGate('Motion access is not available here.');
    }
  });

  async function keepAwake(on: boolean) {
    try {
      if (on && !wakeLock && 'wakeLock' in navigator) {
        wakeLock = await (navigator as unknown as { wakeLock: { request(t: string): Promise<{ release(): Promise<void> }> } }).wakeLock.request('screen');
      } else if (!on && wakeLock) {
        await wakeLock.release();
        wakeLock = null;
      }
    } catch {
      wakeLock = null;
    }
  }

  /* ---------- Rendering ---------- */

  let wasLevel = false;
  /** The reading as shown in text: it only moves past a small deadband so digits don't twitch. */
  let shown: Reading | null = null;
  let lastText = 0;
  let lastShownAt = 0;

  // "Out over" runs on a slower clock: a heavier filter for the drawing, and
  // labels that show the average over each second.
  const SLOW_TAU = 0.6;
  const SLACK = 0.02; // degrees the drawing ignores, like play in a joint
  let slow: { a: number; b: number } | null = null;
  let drawn = { a: 0, b: 0 };
  let slowRef = '';
  let labelDev = 0;
  const win = { sum: 0, n: 0, at: 0 };

  /** Follows `target` only once it's more than SLACK away, so resting flicker never shows. */
  const slack = (held: number, target: number) =>
    Math.abs(target - held) <= SLACK ? held : target - Math.sign(target - held) * SLACK;

  const deg = (v: number) => `${Math.abs(v).toFixed(2)}°`;

  // The long side of the phone is the reference: upright it checks plumb,
  // sideways it checks level. The number is how far off, 0 when true.
  const ref = (r: Reading) => (r.mode === 'flat' ? 'flat' : r.angle > 45 ? 'level' : 'plumb');

  function renderText(r: Reading) {
    odometer.set(Math.abs(r.deviation));
    modeEl.textContent = ref(r).replace(/^./, (c) => c.toUpperCase());
    devEl.textContent = r.mode === 'flat'
      ? `${deg(r.tiltX)} × ${deg(r.tiltY)}`
      : `Lean ${deg(r.lean)}`;
  }

  /** Text updates at ~6 Hz, and only when the reading moved past the deadband. */
  function updateText(r: Reading, now: number) {
    if (now - lastText < 160) return;
    lastText = now;
    // Any shown value counts: the angle, but also the lean or a flat tilt alone.
    const moved = shown
      ? Math.max(
          Math.abs(r.angle - shown.angle),
          Math.abs(r.lean - shown.lean),
          Math.abs(r.tiltX - shown.tiltX),
          Math.abs(r.tiltY - shown.tiltY),
        )
      : Infinity;
    const changedMode = shown && (shown.mode !== r.mode || shown.angle > 45 !== r.angle > 45);
    // Small drifts still land eventually, just not every frame.
    if (moved >= 0.015 || changedMode || (moved >= 0.005 && now - lastShownAt > 1000)) {
      shown = r;
      lastShownAt = now;
      renderText(r);
    }
  }

  function updateOutOver(r: Reading, ref: string, dt: number, now: number) {
    const flat = r.mode === 'flat';
    const a = flat ? r.tiltX : r.deviation;
    const b = flat ? r.tiltY : 0;
    // Snap only when switching level ↔ plumb ↔ flat; any other movement glides.
    if (!slow || ref !== slowRef) {
      slow = { a, b };
      drawn = { a, b };
      slowRef = ref;
      win.sum = 0;
      win.n = 0;
    } else {
      const k = 1 - Math.exp(-dt / SLOW_TAU);
      slow.a += (a - slow.a) * k;
      slow.b += (b - slow.b) * k;
      drawn = { a: slack(drawn.a, slow.a), b: slack(drawn.b, slow.b) };
    }
    layoutChart(flat, drawn.a, drawn.b);

    win.sum += r.deviation;
    win.n++;
    if (now - win.at >= 1000) {
      labelDev = win.sum / win.n;
      labelChart(labelDev, bars[0].steps === null);
      win.at = now;
      win.sum = 0;
      win.n = 0;
    }
  }

  function renderFrame(now: number) {
    frame = requestAnimationFrame(renderFrame);
    if (!raw) return;
    const dt = (now - (lastSample || now)) / 1000;
    const g = filter.push(raw, dt);
    lastSample = now;
    mode = detectMode(g, mode);
    const r = read(g, mode, cal);

    // Text turns to stay upright; while flat there's no "down", so it keeps its last turn.
    if (r.mode === 'edge') setQuarter(screenQuarter(g, quarter));

    // The dial that's horizontal in the world shows level/plumb; the other shows lean.
    // Lying flat, they show tilt across and along the screen.
    let x: number;
    let y: number;
    if (r.mode === 'flat') (x = r.tiltX), (y = r.tiltY);
    else if (quarter % 2 === 0) (x = r.deviation), (y = r.lean);
    else (x = r.lean), (y = r.deviation);
    setDial(dialX, x, dt);
    setDial(dialY, y, dt);

    updateOutOver(r, ref(r), dt, now);

    const isLevel = Math.abs(r.deviation) < 0.05;
    if (isLevel !== wasLevel) {
      screen.classList.toggle('is-level', isLevel);
      if (isLevel) haptic();
      wasLevel = isLevel;
    }

    updateText(r, now);
  }

  function setActive(on: boolean) {
    if (on === active) return;
    active = on;
    if (on) {
      sizeDials();
      sizeChart();
      start();
      keepAwake(true);
      lastSample = 0;
      frame = requestAnimationFrame(renderFrame);
    } else {
      stopListening();
      keepAwake(false);
      cancelAnimationFrame(frame);
    }
  }

  /* ---------- Controls ---------- */

  $('lvl-zero').addEventListener('click', () => {
    if (!filter.value) return;
    haptic();
    cal = calibrate(filter.value, mode, cal);
    save('levelCal', cal);
  });

  $('lvl-reset').addEventListener('click', () => {
    haptic();
    cal = noCalibration();
    save('levelCal', cal);
  });

  function renderPrec() {
    precChip.querySelector('.chip-text')!.innerHTML = prettyHTML(precisionLabel(precision));
  }
  precChip.addEventListener('click', () => {
    haptic();
    openPrecisionSheet(precision, (p) => {
      precision = p;
      save('levelPrec', p);
      renderPrec();
      labelChart(labelDev, true);
    });
  });
  renderPrec();
  odometer.set(0);
  sizeDials();
  sizeChart();
  layoutChart(false, 0, 0);
  labelChart(0, true);

  window.addEventListener('resize', () => {
    sizeDials();
    sizeChart();
  });
  const isLevelTab = () => document.querySelector<HTMLElement>('.app')?.dataset.tab === 'level';
  document.addEventListener('tab:change', () => setActive(isLevelTab()));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) setActive(false);
    else setActive(isLevelTab());
  });
</script>
