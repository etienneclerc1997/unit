---
import Icon from './Icon.astro';

const DISTANCES: [number, string][] = [[12, '1′'], [24, '2′'], [48, '4′'], [96, '8′']];
---

<section class="screen" id="screen-level" data-screen="level" aria-label="Level">
  <div class="lvl-head">
    <div class="lvl-meta">
      <span class="lamp"></span>
      <span id="lvl-mode">Level</span>
      <span class="lvl-dev" id="lvl-dev"></span>
    </div>
    <div class="lvl-actions">
      <button class="pill-btn small" id="lvl-zero" aria-label="Calibrate: make this position read level">Zero</button>
      <button class="pill-btn small quiet" id="lvl-reset" aria-label="Clear calibration">Reset</button>
    </div>
  </div>

  <div class="lvl-dial">
    <svg id="dial" viewBox="50 8 260 96" aria-hidden="true"></svg>
    <div class="lvl-angle" id="lvl-angle" aria-live="off"></div>
    <div class="bullseye" aria-hidden="true">
      <span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span>
      <span class="cross h"></span><span class="cross v"></span>
      <span class="bubble" id="bull-bubble"></span>
    </div>
  </div>

  <div class="lvl-offset">
    <div class="offset-head">
      <span class="caps">Out over</span>
      <button class="chip" id="lvl-prec" aria-label="Offset precision">
        <span class="chip-text">1/64</span>
        <Icon name="chevron" />
      </button>
    </div>
    <div class="dist-row" role="radiogroup" aria-label="Distance">
      {DISTANCES.map(([d, label]) => (
        <button class="dist" role="radio" data-d={d} aria-checked="false">
          <span class="dist-label">{label}</span>
          <span class="dist-value">–</span>
        </button>
      ))}
    </div>
    <svg id="gauge" viewBox="0 0 360 58" aria-hidden="true"></svg>
  </div>

  <div class="lvl-gate" id="lvl-gate" hidden>
    <p id="lvl-gate-text"></p>
    <button class="pill-btn" id="lvl-enable" hidden>Enable level</button>
  </div>
</section>

<script>
  import {
    GravityFilter, detectMode, read, calibrate, offsetAt, noCalibration,
    type Calibration, type LevelMode, type Reading, type Vec3,
  } from '../lib/level';
  import { haptic, load, save, loadPrecision, openPrecisionSheet, prettyHTML, precisionLabel, roundHTML } from '../lib/ui';
  import { toFraction, fractionText } from '../lib/units';
  import { Odometer } from '../lib/odometer';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const SVG = 'http://www.w3.org/2000/svg';
  const DEG = 180 / Math.PI;

  const screen = $('screen-level');
  const odometer = new Odometer($('lvl-angle'));
  const modeEl = $('lvl-mode');
  const devEl = $('lvl-dev');
  const gate = $('lvl-gate');
  const gateText = $('lvl-gate-text');
  const enableBtn = $<HTMLButtonElement>('lvl-enable');
  const bullBubble = $('bull-bubble');
  const precChip = $('lvl-prec');
  const dists = Array.from(document.querySelectorAll<HTMLButtonElement>('.dist'));

  let cal: Calibration = { ...noCalibration(), ...load<Partial<Calibration>>('levelCal', {}) };
  let distance = load<number>('levelDist', 12);
  let precision = loadPrecision('levelPrec', 64);

  /* ---------- SVG helpers ---------- */

  function el(name: string, attrs: Record<string, string | number>, parent: Element, text?: string) {
    const n = document.createElementNS(SVG, name);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    if (text !== undefined) n.textContent = text;
    parent.append(n);
    return n;
  }

  /* ---------- Circular vernier dial ----------
     The top arc of a large circle. The main scale (1° per division) turns with
     the reading; the fixed vernier (10 divisions spanning 9°) reads tenths:
     the vernier line that lines up with a main line gives the tenth. */

  const R = 560;
  const CX = 180;
  const BASE = 58; // y of the shared baseline at the top of the arc
  const CY = BASE + R;
  const U = 11 / R; // radians of arc per degree of reading (≈ 11px)

  const polar = (r: number, phi: number) => [CX + r * Math.sin(phi), CY - r * Math.cos(phi)];

  const dial = $('dial') as unknown as SVGSVGElement;
  const mainScale = el('g', { class: 'main-scale' }, dial);
  for (let v = -60; v <= 150; v++) {
    const phi = v * U;
    const len = v % 10 === 0 ? 18 : v % 5 === 0 ? 13 : 7;
    const [x1, y1] = polar(R, phi);
    const [x2, y2] = polar(R + len, phi);
    el('line', { x1, y1, x2, y2, class: v % 5 === 0 ? 'tk major' : 'tk' }, mainScale);
    if (v % 5 === 0) {
      const [tx, ty] = polar(R + 29, phi);
      const label = v < 0 ? `−${-v}` : String(v);
      el('text', { x: tx, y: ty, class: 'tl', transform: `rotate(${phi * DEG} ${tx} ${ty})` }, mainScale, label);
    }
  }
  {
    const edgeY = CY - Math.sqrt(R * R - 200 * 200);
    el('path', { d: `M ${CX - 200} ${edgeY} A ${R} ${R} 0 0 1 ${CX + 200} ${edgeY}`, class: 'base' }, dial);
  }

  const vernierTicks: Element[] = [];
  const vernier = el('g', { class: 'vernier' }, dial);
  for (let k = 0; k <= 10; k++) {
    const phi = k * 0.9 * U;
    const len = k % 5 === 0 ? 14 : 9;
    const [x1, y1] = polar(R, phi);
    const [x2, y2] = polar(R - len, phi);
    vernierTicks.push(el('line', { x1, y1, x2, y2, class: 'vk' }, vernier));
    if (k % 5 === 0 && k > 0) {
      // Labeled in degrees: the vernier adds .5 or a full 1 to the main reading.
      const [tx, ty] = polar(R - 24, phi);
      el('text', { x: tx, y: ty, class: 'vl', transform: `rotate(${phi * DEG} ${tx} ${ty})` }, vernier, k === 5 ? '.5' : '1');
    }
  }
  {
    const [x1, y1] = polar(R + 24, 0);
    const [x2, y2] = polar(R - 30, 0);
    el('line', { x1, y1, x2, y2, class: 'index' }, dial);
  }

  /* ---------- Linear vernier gauge for the offset ----------
     Main scale in 1/16″ slides with the offset (a distance, so 0 and up); the
     fixed vernier has 4 divisions spanning 3/16″, so it reads to 1/64″. */

  const PX = 192; // px per inch: 12px per 1/16″
  const GX = 56; // the index sits left of center, leaving room for the scale
  const GBASE = 30;
  const gauge = $('gauge') as unknown as SVGSVGElement;
  const gaugeScale = el('g', { class: 'main-scale' }, gauge);
  const fracLabel = (sixteenths: number) => {
    let n = sixteenths;
    const whole = Math.floor(n / 16);
    n %= 16;
    let d = 16;
    while (n && n % 2 === 0) (n /= 2), (d /= 2);
    const f = n ? `${n}/${d}` : '';
    return whole && f ? `${whole} ${f}` : whole ? String(whole) : f || '0';
  };
  for (let s = 0; s <= 12 * 16; s++) {
    const x = GX + (s / 16) * PX;
    const len = s % 4 === 0 ? 14 : s % 2 === 0 ? 9 : 6;
    el('line', { x1: x, y1: GBASE, x2: x, y2: GBASE - len, class: s % 4 === 0 ? 'tk major' : 'tk' }, gaugeScale);
    if (s % 4 === 0) el('text', { x, y: GBASE - 19, class: 'tl fr' }, gaugeScale, fracLabel(s));
  }
  el('line', { x1: 0, y1: GBASE, x2: 360, y2: GBASE, class: 'base' }, gauge);
  const gaugeTicks: Element[] = [];
  for (let k = 0; k <= 4; k++) {
    const x = GX + k * 9;
    gaugeTicks.push(el('line', { x1: x, y1: GBASE, x2: x, y2: GBASE + (k % 4 === 0 ? 13 : 9), class: 'vk' }, gauge));
  }
  el('text', { x: GX + 36 + 6, y: GBASE + 12, class: 'vl start fr' }, gauge, '1/64″');
  el('line', { x1: GX, y1: GBASE - 20, x2: GX, y2: GBASE + 18, class: 'index' }, gauge);

  /* ---------- Sensor ---------- */

  // iOS reports accelerationIncludingGravity with the opposite sign to the spec/Android.
  const IOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const SIGN = IOS ? -1 : 1;

  const filter = new GravityFilter();
  let raw: Vec3 | null = null;
  let lastSample = 0;
  let mode: LevelMode = 'edge';
  let listening = false;
  let active = false;
  let gotData = false;
  let frame = 0;
  let wakeLock: { release(): Promise<void> } | null = null;
  let noDataTimer = 0;

  function onMotion(e: DeviceMotionEvent) {
    const a = e.accelerationIncludingGravity;
    if (!a || a.x === null || a.y === null || a.z === null) return;
    raw = { x: SIGN * a.x, y: SIGN * a.y, z: SIGN * a.z };
    if (!gotData) {
      gotData = true;
      showGate(null);
    }
  }

  function showGate(text: string | null, withButton = false) {
    gate.hidden = text === null;
    screen.classList.toggle('gated', text !== null);
    gateText.textContent = text ?? '';
    enableBtn.hidden = !withButton;
  }

  function listen() {
    if (listening) return;
    listening = true;
    window.addEventListener('devicemotion', onMotion);
    clearTimeout(noDataTimer);
    noDataTimer = window.setTimeout(() => {
      if (gotData) return;
      // Silence usually means permission is needed (iOS); otherwise there's no sensor.
      if (needsPermission()) showGate('The level uses your phone’s motion sensor.', true);
      else showGate('No motion sensor found. Open this on your phone, over HTTPS.');
    }, 1200);
  }

  function stopListening() {
    listening = false;
    window.removeEventListener('devicemotion', onMotion);
    clearTimeout(noDataTimer);
  }

  type PermissionAPI = { requestPermission?: () => Promise<'granted' | 'denied'> };

  const needsPermission = () =>
    typeof (DeviceMotionEvent as unknown as PermissionAPI).requestPermission === 'function';

  function start() {
    if (typeof DeviceMotionEvent === 'undefined') {
      showGate('This browser has no access to motion sensors.');
      return;
    }
    listen();
  }

  enableBtn.addEventListener('click', async () => {
    haptic();
    try {
      const res = await (DeviceMotionEvent as unknown as PermissionAPI).requestPermission!();
      if (res === 'granted') {
        showGate(null);
        stopListening();
        listen();
      } else showGate('Motion access was denied. Allow it in Settings › Safari › Motion & Orientation Access.');
    } catch {
      showGate('Motion access is not available here.');
    }
  });

  async function keepAwake(on: boolean) {
    try {
      if (on && !wakeLock && 'wakeLock' in navigator) {
        wakeLock = await (navigator as unknown as { wakeLock: { request(t: string): Promise<{ release(): Promise<void> }> } }).wakeLock.request('screen');
      } else if (!on && wakeLock) {
        await wakeLock.release();
        wakeLock = null;
      }
    } catch {
      wakeLock = null;
    }
  }

  /* ---------- Rendering ---------- */

  let wasLevel = false;
  const DIAL_TAU = 0.18;
  let dialAngle: number | null = null;
  /** The reading as shown in text: it only moves past a small deadband so digits don't twitch. */
  let shown: Reading | null = null;
  let lastText = 0;
  let lastShownAt = 0;

  /* "Out over" runs on its own, slower clock. The gauge follows a heavier filter
     (~0.6 s). The numbers show the average over their update window (0.5 s for
     the selected distance, 1.5 s for the others), with hysteresis so a value
     sitting between two fractions doesn't flip back and forth. */
  const SLOW_TAU = 0.6;
  let slowDev: number | null = null;
  /** Running averages of the deviation since each window last refreshed. */
  const windows = {
    selected: { ms: 500, sum: 0, n: 0, at: 0 },
    others: { ms: 1500, sum: 0, n: 0, at: 0 },
  };
  /** Displayed value per distance, in steps of 1/precision. */
  const shownSteps = new Map<number, number>();

  function distHTML(off: number, steps: number) {
    const shownInches = steps / precision;
    // The ± mark compares the real offset with the fraction on screen.
    const diff = off - shownInches;
    const dir = steps === 0 || Math.abs(diff) * precision < 0.1 ? 0 : diff > 0 ? 1 : -1;
    return prettyHTML(fractionText(toFraction(shownInches, precision)) + '"') + roundHTML(dir);
  }

  /** Render distances from a deviation; `which` picks the selected one, the others, or both. */
  function renderDists(dev: number | null, which: 'selected' | 'others' | 'all', force = false) {
    if (dev === null) return;
    dists.forEach((b) => {
      const d = Number(b.dataset.d);
      const selected = d === distance;
      b.setAttribute('aria-checked', String(selected));
      if ((which === 'selected' && !selected) || (which === 'others' && selected)) return;
      const off = Math.abs(offsetAt(dev, d));
      const exact = off * precision;
      const prev = shownSteps.get(d);
      // Only move once the value is well past the halfway point to the next step.
      if (!force && prev !== undefined && Math.abs(exact - prev) < 0.8) return;
      const steps = Math.round(exact);
      shownSteps.set(d, steps);
      b.querySelector('.dist-value')!.innerHTML = distHTML(off, steps);
    });
  }

  function resetWindows() {
    for (const w of Object.values(windows)) (w.sum = 0), (w.n = 0);
  }

  let slowRef = '';

  function updateDists(dev: number, ref: string, dt: number, now: number) {
    // Snap only when switching level ↔ plumb ↔ flat; any other movement glides.
    if (slowDev === null || ref !== slowRef) {
      slowDev = dev;
      slowRef = ref;
      resetWindows();
    } else slowDev += (dev - slowDev) * (1 - Math.exp(-dt / SLOW_TAU));

    for (const [which, w] of Object.entries(windows) as ['selected' | 'others', typeof windows.selected][]) {
      w.sum += dev;
      w.n++;
      if (now - w.at < w.ms) continue;
      renderDists(w.sum / w.n, which, shownSteps.size === 0);
      w.at = now;
      w.sum = 0;
      w.n = 0;
    }
  }

  function renderText(r: Reading) {
    odometer.set(r.angle);
    modeEl.textContent = r.mode === 'flat' ? 'Flat' : r.angle > 45 ? 'Plumb' : 'Level';
    devEl.textContent = r.mode === 'flat' ? '' : `${Math.abs(r.deviation).toFixed(2)}° off`;
  }

  /** Text updates at ~6 Hz, and only when the reading moved past the deadband. */
  function updateText(r: Reading, now: number) {
    if (now - lastText < 160) return;
    lastText = now;
    const moved = shown ? Math.abs(r.angle - shown.angle) : Infinity;
    const changedMode = shown && (shown.mode !== r.mode || shown.angle > 45 !== r.angle > 45);
    // Small drifts still land eventually, just not every frame.
    if (moved >= 0.015 || changedMode || (moved >= 0.005 && now - lastShownAt > 1000)) {
      shown = r;
      lastShownAt = now;
      renderText(r);
    }
  }

  function renderFrame(now: number) {
    frame = requestAnimationFrame(renderFrame);
    if (!raw) return;
    const dt = (now - (lastSample || now)) / 1000;
    const g = filter.push(raw, dt);
    lastSample = now;
    mode = detectMode(g, mode);
    const r = read(g, mode, cal);

    // Dial: turn the main scale so the reading sits under the index. A light
    // extra filter makes it glide; the readout uses the reading itself.
    dialAngle = dialAngle === null ? r.angle : dialAngle + (r.angle - dialAngle) * (1 - Math.exp(-dt / DIAL_TAU));
    mainScale.setAttribute('transform', `rotate(${-dialAngle * U * DEG} ${CX} ${CY})`);
    const tenth = Math.round(((dialAngle % 1) + 1) % 1 * 10) % 10;
    // On a whole degree the index itself is the match, so nothing else lights up.
    vernierTicks.forEach((t, k) => t.classList.toggle('on', k === tenth && k > 0));

    // Offset gauge for the selected distance, on the slower clock. It shows a
    // distance, so always the magnitude.
    const ref = r.mode === 'flat' ? 'flat' : r.angle > 45 ? 'plumb' : 'level';
    updateDists(r.deviation, ref, dt, now);
    const off = Math.abs(offsetAt(slowDev!, distance));
    gaugeScale.setAttribute('transform', `translate(${-off * PX} 0)`);
    const q = Math.round(((((off * 16) % 1) + 1) % 1) * 4) % 4;
    gaugeTicks.forEach((t, k) => t.classList.toggle('on', k === q && k > 0));

    // Flat: the bubble floats to the high side.
    screen.dataset.mode = r.mode;
    if (r.mode === 'flat') {
      const s = 14; // px per degree
      let bx = r.tiltX * s;
      let by = -r.tiltY * s;
      const m = Math.hypot(bx, by);
      const max = 56;
      if (m > max) (bx *= max / m), (by *= max / m);
      bullBubble.style.transform = `translate(${bx}px, ${by}px)`;
    }

    const isLevel = Math.abs(r.deviation) < 0.05;
    if (isLevel !== wasLevel) {
      screen.classList.toggle('is-level', isLevel);
      if (isLevel) haptic();
      wasLevel = isLevel;
    }

    updateText(r, now);
  }

  function setActive(on: boolean) {
    if (on === active) return;
    active = on;
    if (on) {
      start();
      keepAwake(true);
      lastSample = 0;
      frame = requestAnimationFrame(renderFrame);
    } else {
      stopListening();
      keepAwake(false);
      cancelAnimationFrame(frame);
    }
  }

  /* ---------- Controls ---------- */

  $('lvl-zero').addEventListener('click', () => {
    if (!filter.value) return;
    haptic();
    cal = calibrate(filter.value, mode, cal);
    save('levelCal', cal);
  });

  $('lvl-reset').addEventListener('click', () => {
    haptic();
    cal = noCalibration();
    save('levelCal', cal);
  });

  dists.forEach((b) =>
    b.addEventListener('click', () => {
      haptic();
      distance = Number(b.dataset.d);
      save('levelDist', distance);
      dists.forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      renderDists(slowDev, 'all', true);
    }),
  );

  function renderPrec() {
    precChip.querySelector('.chip-text')!.innerHTML = prettyHTML(precisionLabel(precision));
  }
  precChip.addEventListener('click', () => {
    haptic();
    openPrecisionSheet(precision, (p) => {
      precision = p;
      save('levelPrec', p);
      renderPrec();
      renderDists(slowDev, 'all', true);
    });
  });
  renderPrec();
  odometer.set(0);
  dists.forEach((b) => b.setAttribute('aria-checked', String(Number(b.dataset.d) === distance)));

  const isLevelTab = () => document.querySelector<HTMLElement>('.app')?.dataset.tab === 'level';
  document.addEventListener('tab:change', () => setActive(isLevelTab()));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) setActive(false);
    else setActive(isLevelTab());
  });
</script>
