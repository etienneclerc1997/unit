---
import Icon from './Icon.astro';

// [label, key, style]
const keys: [string, string, string][] = [
  ['AC', 'AC', 'fn'], ['( )', '()', 'fn'], ['/', '/', ''], ['÷', '÷', 'op'],
  ['7', '7', ''], ['8', '8', ''], ['9', '9', ''], ['×', '×', 'op'],
  ['4', '4', ''], ['5', '5', ''], ['6', '6', ''], ['−', '−', 'op'],
  ['1', '1', ''], ['2', '2', ''], ['3', '3', ''], ['+', '+', 'op'],
  ['0', '0', ''], ['.', '.', ''], ['space', ' ', 'small-label'], ['=', '=', 'eq'],
  ['ft', "'", 'unit'], ['in', '"', 'unit'], ['mm', 'mm', 'unit'], ['cm', 'cm', 'unit'],
];
const labels: Record<string, string> = {
  '()': 'Parentheses', '/': 'Fraction', '÷': 'Divide', '×': 'Multiply', '−': 'Minus', '+': 'Plus', ' ': 'Space',
  '=': 'Equals', AC: 'All clear', "'": 'Feet', '"': 'Inches', mm: 'Millimeters', cm: 'Centimeters',
};
---

<section class="screen" id="screen-calc" aria-label="Calculator">
  <div class="display" data-fresh="false">
    <div class="display-top">
      <button class="chip" id="calc-prec" aria-label="Answer precision">
        <span class="chip-text">1/32</span>
        <Icon name="chevron" />
      </button>
      <button class="icon-btn" id="calc-back" aria-label="Delete (hold to clear)">
        <Icon name="backspace" />
      </button>
    </div>
    <div class="history" id="history"></div>
    <div class="expr h-scroll" id="expr" aria-live="polite" role="textbox" aria-label="Equation"></div>
    <div class="result" id="result" aria-live="polite"></div>
  </div>

  <div class="keypad calc-keys">
    {keys.map(([label, k, style]) => (
      <button class:list={['key', style]} data-k={k} aria-label={labels[k]}>
        {label}
      </button>
    ))}
  </div>

  <div class="series" data-mode="repeat">
    <div class="series-bar">
      <button class="mode-toggle" id="mode-toggle" aria-label="Switch between repeat and split">
        <span class="orb orb-xs" id="mode-orb"></span>
        <span id="mode-label">Repeat</span>
        <Icon name="swap" />
      </button>
      <div class="counter">
        <button id="count-dec" aria-label="Fewer"><Icon name="minus" /></button>
        <output id="count" aria-live="polite">2</output>
        <button id="count-inc" aria-label="More"><Icon name="plus" /></button>
      </div>
    </div>
    <div class="line-scroll h-scroll" id="line-scroll">
      <div class="line" id="line"><div class="ruler"></div></div>
    </div>
  </div>
</section>

<script>
  import { lex, evaluate, press, series, emptyState, type CalcState, type SeriesMode, type Item } from '../lib/calc';
  import {
    haptic, load, save, loadPrecision, openPrecisionSheet, prettyHTML, escape, inchHTML, precisionLabel, onLongPress,
  } from '../lib/ui';
  import { toFraction, fractionText } from '../lib/units';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const display = document.querySelector<HTMLElement>('.display')!;
  const exprEl = $('expr');
  const resultEl = $('result');
  const historyEl = $('history');
  const precChip = $('calc-prec');
  const seriesEl = document.querySelector<HTMLElement>('.series')!;
  const lineScroll = $('line-scroll');
  const line = $('line');
  const ruler = line.querySelector<HTMLElement>('.ruler')!;

  let state: CalcState = { ...emptyState(), ...load<Partial<CalcState>>('calc', {}) };
  state.cursor = Math.min(state.cursor ?? state.tokens.length, state.tokens.length);
  let precision = loadPrecision('calcPrec');
  let mode: SeriesMode = load<SeriesMode>('mode', 'repeat') === 'split' ? 'split' : 'repeat';
  let count = Math.min(99, Math.max(1, load<number>('count', 2)));

  /* ---------- Equation rendering ---------- */

  const CARET = '<span class="caret"></span>';
  const tok = (s: number, e: number, html: string, cls = '') => `<span class="tk ${cls}" data-s="${s}" data-e="${e}">${html}</span>`;

  /**
   * Render the equation. A bare number gets a faded ″ (inches is the default
   * unit), except after × or ÷ where it reads as a count.
   */
  function exprHTML(tokens: string[], ans: number, cursor: number | null): string {
    const items = lex(tokens);
    const caret = (i: number) => (cursor === i ? CARET : '');
    let html = caret(0);
    items.forEach((it, n) => {
      const prev: Item | undefined = items[n - 1];
      const next: Item | undefined = items[n + 1];
      switch (it.k) {
        case 'num': {
          if (prev?.k === 'unit') html += '<span class="gap"></span>';
          // Fractions render as one diagonal glyph unless the caret sits inside them.
          if (it.text.includes('/') && !(cursor !== null && cursor > it.s && cursor < it.e)) {
            html += tok(it.s, it.e, prettyHTML(it.text)) + caret(it.e);
          } else {
            [...it.text].forEach((ch, j) => {
              html += tok(it.s + j, it.s + j + 1, ch === ' ' ? '&nbsp;' : escape(ch), ch === ' ' ? 'sp' : '');
              html += caret(it.s + j + 1);
            });
          }
          const scalar = prev?.k === 'op' && (prev.v === '×' || prev.v === '÷');
          if (next?.k !== 'unit' && !scalar) html += '<span class="ghost">″</span>';
          break;
        }
        case 'ans':
          html += tok(it.s, it.e, inchHTML(ans, precision), 'ans') + caret(it.e);
          break;
        case 'op':
          html += tok(it.s, it.e, it.v, 'op-sym') + caret(it.e);
          break;
        case 'lp':
          html += tok(it.s, it.e, '(') + caret(it.e);
          break;
        case 'rp':
          html += tok(it.s, it.e, ')') + caret(it.e);
          break;
        case 'unit': {
          const u = it.v === "'" ? '′' : it.v === '"' ? '″' : `&thinsp;${it.v}`;
          html += tok(it.s, it.e, u, 'unit-sym') + caret(it.e);
          break;
        }
      }
    });
    return html;
  }

  function keepCaretVisible() {
    if (state.cursor >= state.tokens.length) {
      exprEl.scrollLeft = exprEl.scrollWidth;
      return;
    }
    const c = exprEl.querySelector<HTMLElement>('.caret');
    if (!c) return;
    const x = c.offsetLeft;
    if (x < exprEl.scrollLeft + 24) exprEl.scrollLeft = x - 24;
    else if (x > exprEl.scrollLeft + exprEl.clientWidth - 24) exprEl.scrollLeft = x - exprEl.clientWidth + 24;
  }

  function render() {
    const onlyAns = state.tokens.length === 1 && state.tokens[0] === 'ANS';
    exprEl.innerHTML = exprHTML(state.tokens, state.ans, state.fresh ? null : state.cursor);
    const len = exprEl.textContent!.length;
    exprEl.dataset.size = len > 16 ? 's' : len > 10 ? 'm' : '';
    exprEl.classList.toggle('scrollable', exprEl.scrollWidth > exprEl.clientWidth + 1);
    keepCaretVisible();

    const v = evaluate(state.tokens, state.ans);
    resultEl.innerHTML = v === null || onlyAns ? '' : inchHTML(v, precision);
    display.dataset.fresh = String(state.fresh);

    historyEl.innerHTML =
      state.history && state.tokens[0] === 'ANS' ? `<span>${exprHTML(state.history, state.historyAns, null)} =</span>` : '';

    precChip.querySelector('.chip-text')!.innerHTML = prettyHTML(precisionLabel(precision));
    renderSeries();
    save('calc', state);
  }

  /* ---------- Repeat / split ruler ---------- */

  function renderSeries() {
    seriesEl.dataset.mode = mode;
    $('mode-label').textContent = mode === 'repeat' ? 'Repeat' : 'Split';
    $('mode-orb').className = `orb orb-xs ${mode === 'repeat' ? 'orb-ocean' : 'orb-sunset'}`;
    $('count').textContent = String(count);
    $<HTMLButtonElement>('count-dec').disabled = count <= 1;
    $<HTMLButtonElement>('count-inc').disabled = count >= 99;

    // Right after "=", repeat still follows the equation that produced the answer.
    const useHistory = mode === 'repeat' && state.tokens.length === 1 && state.tokens[0] === 'ANS' && state.history;
    const pts = useHistory
      ? series(mode, state.history!, state.historyAns, count)
      : series(mode, state.tokens, state.ans, count);

    line.querySelector('.line-empty')?.remove();
    if (!pts) {
      line.querySelectorAll('.pt').forEach((p) => p.remove());
      ruler.hidden = true;
      line.style.width = '';
      lineScroll.classList.remove('scrollable');
      const empty = document.createElement('div');
      empty.className = 'line-empty';
      empty.textContent = mode === 'repeat' ? 'Type an equation to repeat it' : 'Type a measurement to split it';
      line.append(empty);
      return;
    }
    ruler.hidden = false;

    const labels = pts.map((p) => fractionText(toFraction(p, precision)));
    const longest = Math.max(...labels.map((l) => l.length));
    // Diagonal fractions are compact: roughly 6.6px per character at 13px, plus the ″ and arrow.
    const labelW = longest * 6.6 + 30;
    const pad = Math.ceil(labelW / 2);
    const avail = lineScroll.clientWidth;
    const segW = Math.max(labelW, (avail - pad * 2) / (pts.length - 1));
    const width = Math.max(avail, Math.ceil(pad * 2 + segW * (pts.length - 1)));
    const seg = (width - pad * 2) / (pts.length - 1);
    line.style.width = `${width}px`;
    line.style.setProperty('--pad', `${pad}px`);
    // Minor ticks every ~7px, evenly dividing each segment so they line up with the majors.
    line.style.setProperty('--period', `${seg / Math.max(1, Math.round(seg / 7))}px`);
    lineScroll.classList.toggle('scrollable', width > avail);

    const existing = Array.from(line.querySelectorAll<HTMLElement>('.pt'));
    existing.slice(pts.length).forEach((p) => p.remove());
    pts.forEach((p, i) => {
      let el = existing[i];
      if (!el) {
        el = document.createElement('div');
        el.className = 'pt';
        el.innerHTML = '<span class="pt-label"></span><span class="pt-tick"></span>';
        line.append(el);
      }
      el.classList.toggle('end', i === 0 || i === pts.length - 1);
      el.querySelector('.pt-label')!.innerHTML = inchHTML(p, precision);
      el.style.left = `${pad + i * seg}px`;
    });
  }

  /* ---------- Input ---------- */

  function key(k: string) {
    const next = press(state, k);
    if (k === '=' && next === state && state.tokens.length) {
      display.dataset.error = 'true';
      setTimeout(() => (display.dataset.error = 'false'), 300);
    }
    state = next;
    render();
  }

  document.querySelector('.calc-keys')!.addEventListener('click', (e) => {
    const k = (e.target as HTMLElement).closest<HTMLButtonElement>('.key');
    if (!k) return;
    haptic();
    key(k.dataset.k!);
  });

  const back = $('calc-back');
  back.addEventListener('click', () => (haptic(), key('⌫')));
  onLongPress(back, () => (haptic(), key('AC')));

  // Tap in the equation to move the caret, like a text field.
  exprEl.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('.tk');
    let cursor = state.tokens.length;
    if (t) {
      const r = t.getBoundingClientRect();
      cursor = e.clientX < r.left + r.width / 2 ? Number(t.dataset.s) : Number(t.dataset.e);
    } else {
      const first = exprEl.querySelector<HTMLElement>('.tk');
      if (first && e.clientX < first.getBoundingClientRect().left && e.clientX > first.getBoundingClientRect().left - 32) cursor = 0;
    }
    haptic();
    state = { ...state, cursor, fresh: false };
    render();
  });

  $('mode-toggle').addEventListener('click', () => {
    haptic();
    mode = mode === 'repeat' ? 'split' : 'repeat';
    save('mode', mode);
    renderSeries();
  });

  const step = (d: number) => {
    haptic();
    count = Math.min(99, Math.max(1, count + d));
    save('count', count);
    renderSeries();
  };
  $('count-dec').addEventListener('click', () => step(-1));
  $('count-inc').addEventListener('click', () => step(1));

  precChip.addEventListener('click', () => {
    haptic();
    openPrecisionSheet(precision, (p) => {
      precision = p;
      save('calcPrec', p);
      render();
    });
  });

  // Hardware keyboard support.
  document.addEventListener('keydown', (e) => {
    if (document.querySelector('.app')?.getAttribute('data-tab') !== 'calc' || e.metaKey || e.ctrlKey) return;
    if (document.body.classList.contains('sheet-open')) return;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      e.preventDefault();
      const c = state.cursor + (e.key === 'ArrowLeft' ? -1 : 1);
      state = { ...state, cursor: Math.max(0, Math.min(state.tokens.length, c)), fresh: false };
      return render();
    }
    const map: Record<string, string> = {
      Enter: '=', '=': '=', Backspace: '⌫', Escape: 'AC', Delete: 'AC', ' ': ' ',
      '*': '×', x: '×', '-': '−', '+': '+', ':': '÷', '(': '()', ')': '()', "'": "'", '"': '"',
    };
    let k = /^[\d.]$/.test(e.key) ? e.key : map[e.key];
    // "/" types a fraction after a digit, otherwise divides.
    if (e.key === '/') k = /\d$/.test(state.tokens[state.cursor - 1] ?? '') ? '/' : '÷';
    if (!k) return;
    e.preventDefault();
    key(k);
  });

  window.addEventListener('resize', renderSeries);
  document.addEventListener('tab:change', renderSeries);
  render();
</script>
