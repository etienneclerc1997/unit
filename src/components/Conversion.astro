---
import { FIELDS } from '../lib/units';
import Icon from './Icon.astro';
---

<section class="screen" id="screen-convert" aria-label="Conversion">
  <div class="fold-main">
  <div class="fields">
    {FIELDS.map((f) => (
      <div class="field-wrap">
        <button class="field" data-key={f.key} aria-pressed="false" aria-label={f.label}>
          <span class="field-label">{f.label}</span>
          <span class="field-value"></span>
        </button>
        {f.key === 'inFrac' && (
          <button class="chip" id="conv-prec" aria-label="Fraction precision">
            <span class="chip-text">1/32</span>
            <Icon name="chevron" />
          </button>
        )}
      </div>
    ))}
  </div>

  <div class="conv-spacer"></div>

  <!-- Room for the keypad, which sits in a fixed layer over the screens (see index). -->
  <div class="keypad-slot" style="--rows: 5"></div>
  </div>
</section>

<script>
  import { FIELDS, type FieldDef, type FieldKey } from '../lib/units';
  import {
    haptic, shared, load, save, loadPrecision, openPrecisionSheet, prettyHTML, precisionLabel,
    onLongPress, roundHTML, inchHTML, updateDenoms, onDenom,
  } from '../lib/ui';

  const fieldEls = new Map<FieldKey, HTMLButtonElement>();
  document.querySelectorAll<HTMLButtonElement>('.field').forEach((el) => fieldEls.set(el.dataset.key as FieldKey, el));
  const defOf = (key: FieldKey) => FIELDS.find((f) => f.key === key)!;

  interface ConvState {
    active: FieldKey;
    text: string; // what the user typed in the active field
    inches: number | null;
  }

  let state: ConvState = load('conv', { active: 'inFrac', text: '', inches: null });
  let fresh = true; // the active field's text is "selected": the next key replaces it
  let precision = loadPrecision('convPrec');

  const precChip = document.getElementById('conv-prec')!;
  const denoms = document.getElementById('conv-denoms')!;

  /* ---------- Rendering ---------- */

  const unitHTML = (u: string) => `<span class="field-unit">${u}</span>`;
  const CARET = '<span class="caret"></span>';
  const PLACEHOLDER = '<span class="ph">0</span>';
  // Typed spaces don't break, or one at the end (as in "3 ", before "1/2") would vanish.
  const NBSP = String.fromCharCode(160);
  const typedHTML = (t: string) => prettyHTML(t.replace(/ /g, NBSP));

  /** Feet are typed as `5'3 1/2`: ′ is always shown, ″ once the inches part has started. */
  function feetHTML(text: string, caret: string, active: boolean): string {
    const t = text.replace(/"$/, '').replace("' ", "'");
    const i = t.indexOf("'");
    if (i < 0) return (t ? typedHTML(t) : '') + caret + (t ? '' : PLACEHOLDER) + unitHTML('′');
    const inch = t.slice(i + 1);
    const showInch = inch !== '' || active;
    return (
      typedHTML(t.slice(0, i)) + unitHTML('′') +
      (showInch ? '&ensp;' + typedHTML(inch) + caret + unitHTML('″') : caret)
    );
  }

  function fieldHTML(f: FieldDef, text: string, active: boolean): string {
    const caret = active && !fresh ? CARET : '';
    let html: string;
    if (f.key === 'ftFrac') html = feetHTML(text, caret, active);
    else {
      const unit = f.unit === '"' ? '″' : f.unit;
      html = (text ? typedHTML(text) + caret : caret + PLACEHOLDER) + (unit ? unitHTML(unit) : '');
    }
    if (active && fresh && text) html = `<span class="sel">${html}</span>`;
    // Mark rounding on values we formatted (not on what's being typed).
    if (f.dir && state.inches !== null && (!active || fresh)) html += roundHTML(f.dir(state.inches, precision));
    return html;
  }

  function render() {
    for (const f of FIELDS) {
      const el = fieldEls.get(f.key)!;
      const isActive = f.key === state.active;
      const text = isActive ? state.text : state.inches === null ? '' : f.format(state.inches, precision);
      const value = el.querySelector<HTMLElement>('.field-value')!;
      value.innerHTML = fieldHTML(f, text, isActive);
      const len = text.length + (f.key === 'ftFrac' ? 2 : f.unit.length > 1 ? 1 : 0);
      value.dataset.size = len > 11 ? 's' : len > 8 ? 'm' : '';
      el.setAttribute('aria-pressed', String(isActive));
    }
    precChip.querySelector('.chip-text')!.innerHTML = prettyHTML(precisionLabel(precision));

    const def = defOf(state.active);
    document.querySelectorAll<HTMLButtonElement>('.keypad .key[data-kind]').forEach((k) => {
      const kind = k.dataset.kind;
      k.classList.toggle('off',
        (kind === 'frac' && !def.fractional) ||
        (kind === 'ft' && (def.key !== 'ftFrac' || (!fresh && state.text.includes("'")))),
      );
    });

    updateDenoms(denoms, !fresh && state.text.endsWith('/') ? state.text.slice(0, -1) : null);

    save('conv', state);
    shared.convPeek = state.inches === null ? '' : inchHTML(state.inches, precision);
  }

  /* ---------- Input ---------- */

  function activate(key: FieldKey) {
    if (key === state.active) {
      // Tapping the active field again toggles between "select all" and caret-at-end.
      if (state.text) fresh = !fresh;
    } else {
      state = { ...state, active: key, text: state.inches === null ? '' : defOf(key).format(state.inches, precision) };
      fresh = true;
    }
    render();
  }

  function input(k: string) {
    const def = defOf(state.active);
    let text = state.text;
    if (k === 'clear') {
      state = { ...state, text: '', inches: null };
      fresh = true;
      return render();
    }
    if (k === 'back') {
      text = fresh ? '' : text.slice(0, -1);
    } else {
      if (fresh) text = '';
      const part = text.split(/[\s/']/).pop() ?? '';
      if (k === '.' && part.includes('.')) return;
      if (k === '.' && (text === '' || /[\s/']$/.test(text))) text += '0';
      if (k === ' ' && (text === '' || /[\s/'.]$/.test(text) || /[ /]/.test(text.split("'").pop()!))) return;
      if (k === '/' && (!/\d$/.test(text) || /[/.]/.test(text.split(/[\s']/).pop() ?? ''))) return;
      if (k === "'") {
        // ft ′ jumps to the inches part.
        if (text.includes("'") || (text !== '' && !/\d$/.test(text))) return;
        if (text === '') text = '0';
      }
      if (text.length >= 16) return;
      text += k;
    }
    fresh = false;
    // A half-typed value ("3 1/") keeps the last good conversion visible.
    const parsed = def.parse(text);
    state = { ...state, text, inches: text === '' ? null : parsed ?? state.inches };
    render();
  }

  fieldEls.forEach((el, key) => el.addEventListener('click', () => (haptic(), activate(key))));

  // The keypad is shared with the calculator, whose key names it uses.
  const onConvert = () => document.querySelector('.app')?.getAttribute('data-tab') === 'convert';
  const KEY: Record<string, string> = { '⌫': 'back', AC: 'clear' };
  document.querySelector('.keypad')!.addEventListener('click', (e) => {
    const k = (e.target as HTMLElement).closest<HTMLButtonElement>('.key');
    if (!k || !onConvert() || k.matches('.extra, .off')) return;
    haptic();
    input(KEY[k.dataset.k!] ?? k.dataset.k!);
  });

  onLongPress(document.querySelector<HTMLElement>('.keypad [data-k="⌫"]')!, () => {
    if (!onConvert()) return;
    haptic();
    input('clear');
  });
  onDenom(denoms, (digits) => digits.forEach(input));

  precChip.addEventListener('click', () => {
    haptic();
    openPrecisionSheet(precision, (p) => {
      precision = p;
      save('convPrec', p);
      // An untouched value in a fraction field follows the new precision.
      const def = defOf(state.active);
      if (fresh && def.fractional && state.inches !== null) state.text = def.format(state.inches, p);
      render();
    });
  });

  // Hardware keyboard support (desktop / tablets).
  document.addEventListener('keydown', (e) => {
    if (document.querySelector('.app')?.getAttribute('data-tab') !== 'convert' || e.metaKey || e.ctrlKey) return;
    if (document.body.classList.contains('sheet-open')) return;
    const map: Record<string, string> = { Backspace: 'back', Escape: 'clear', Delete: 'clear' };
    const k = e.key in map ? map[e.key] : e.key;
    if (/^[\d./' ]$/.test(k) || k === 'back' || k === 'clear') {
      e.preventDefault();
      input(k);
    } else if (k === 'Tab') {
      e.preventDefault();
      const i = FIELDS.findIndex((f) => f.key === state.active);
      activate(FIELDS[(i + (e.shiftKey ? FIELDS.length - 1 : 1)) % FIELDS.length].key);
    }
  });

  // Restore: show the stored value formatted in the active field.
  if (state.inches !== null) state.text = defOf(state.active).format(state.inches, precision);
  render();
</script>
