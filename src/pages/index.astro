---
import App from '../layouts/App.astro';
import Conversion from '../components/Conversion.astro';
import Calculator from '../components/Calculator.astro';
import Level from '../components/Level.astro';
import Keypad from '../components/Keypad.astro';
import { PRECISIONS } from '../lib/units';
---

<App title="Unit">
  <main class="app" data-tab="convert" style="--i: 0">
    <div class="tabs" role="tablist">
      <div class="tabs-thumb"></div>
      <button class="tab" role="tab" data-tab="convert" aria-selected="true" aria-controls="screen-convert">
        <span class="tab-label">Convert</span>
      </button>
      <button class="tab" role="tab" data-tab="calc" aria-selected="false" aria-controls="screen-calc">
        <span class="tab-label">Calculate</span>
      </button>
      <button class="tab" role="tab" data-tab="level" aria-selected="false" aria-controls="screen-level">
        <span class="tab-label">Level</span>
      </button>
    </div>

    <div class="viewport">
      <div class="track">
        <Conversion />
        <Calculator />
        <Level />
      </div>
      <!-- One keypad for Convert and Calculate: it holds still and morphs while
           the screens slide under it, and leaves with the calculator for Level. -->
      <div class="keys-layer">
        <Keypad />
      </div>
    </div>
  </main>

  <div class="sheet-scrim"></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title" aria-hidden="true">
    <div class="sheet-grip-area"><div class="sheet-grip"></div></div>
    <h2 id="sheet-title">Precision</h2>
    <p>
      Fractions round to the nearest step and show in their simplest form. A <span class="rd up">+</span> means
      the real value is a little larger, a <span class="rd down">−</span> a little smaller.
    </p>
    <div class="prec-grid" role="radiogroup">
      {PRECISIONS.map((p) => (
        <button class="prec-opt" role="radio" data-p={p} aria-checked="false">
          <span class="fr">1/{p}</span>
        </button>
      ))}
    </div>
  </div>
</App>

<script>
  import { haptic, shared, load, save, initPrecisionSheet, suppressNextClick } from '../lib/ui';

  const TABS = ['convert', 'calc', 'level'];
  const app = document.querySelector<HTMLElement>('.app')!;
  const track = app.querySelector<HTMLElement>('.track')!;
  const viewport = app.querySelector<HTMLElement>('.viewport')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const screens = track.querySelectorAll<HTMLElement>('.screen');
  const convLabel = document.querySelector<HTMLElement>('.tab[data-tab="convert"] .tab-label')!;
  const keysLayer = app.querySelector<HTMLElement>('.keys-layer')!;
  const keypad = app.querySelector<HTMLElement>('.keypad')!;
  const index = () => Math.max(0, TABS.indexOf(app.dataset.tab!));

  function setTab(tab: string) {
    const i = Math.max(0, TABS.indexOf(tab));
    app.dataset.tab = TABS[i];
    app.style.setProperty('--i', String(i));
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === TABS[i])));
    screens.forEach((s, n) => s.classList.toggle('active', n === i));
    // Only the active screen keeps its section below the fold. Head back up first
    // if we're down there, so the page doesn't jump when the old one goes.
    if (viewport.scrollTop > 1) {
      pendingMore = true;
      viewport.scrollTo({ top: 0, behavior: 'smooth' });
    } else syncMore();
    // Away from Convert, its tab peeks at the last converted value.
    convLabel.innerHTML = i > 0 && shared.convPeek ? shared.convPeek : 'Convert';
    save('tab', TABS[i]);
    document.dispatchEvent(new CustomEvent('tab:change', { detail: TABS[i] }));
  }

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      if (app.dataset.tab === t.dataset.tab) return;
      haptic();
      setTab(t.dataset.tab!);
    }),
  );

  /* ---------- Below the fold ---------- */

  // The viewport scrolls vertically for every screen at once, so the shared keypad
  // scrolls natively with whichever page is showing.
  let pendingMore = false;
  const syncMore = () => {
    pendingMore = false;
    screens.forEach((s, n) => s.classList.toggle('no-more', n !== index()));
  };

  viewport.addEventListener(
    'scroll',
    () => {
      // Overflow can't be clipped sideways in a vertical scroller; never let focus shift it.
      if (viewport.scrollLeft) viewport.scrollLeft = 0;
      viewport.classList.toggle('scrolled', viewport.scrollTop > 24);
      if (pendingMore && viewport.scrollTop <= 1) syncMore();
    },
    { passive: true },
  );

  screens.forEach((s) =>
    s.querySelector('.fold-hint')?.addEventListener('click', () => {
      haptic();
      viewport.scrollTo({ top: viewport.scrollHeight, behavior: 'smooth' });
    }),
  );

  /* ---------- Swipe between screens ---------- */

  let start: { x: number; y: number; t: number; id: number } | null = null;
  let dragging = false;

  viewport.addEventListener('pointerdown', (e) => {
    // Leave horizontally scrollable areas (long equation, long series line) alone.
    if ((e.target as HTMLElement).closest('.h-scroll.scrollable')) return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    start = { x: e.clientX, y: e.clientY, t: e.timeStamp, id: e.pointerId };
    dragging = false;
  });

  viewport.addEventListener('pointermove', (e) => {
    if (!start || e.pointerId !== start.id) return;
    const dx = e.clientX - start.x;
    const dy = e.clientY - start.y;
    if (!dragging) {
      if (Math.abs(dx) < 12 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
      dragging = true;
      viewport.setPointerCapture(e.pointerId);
      app.classList.add('swiping');
    }
    // Follow the finger directly; CSS takes over again on release.
    const w = viewport.clientWidth;
    const min = -w * (TABS.length - 1);
    let x = -w * index() + dx;
    // Rubber-band past either end.
    if (x > 0) x /= 4;
    if (x < min) x = min + (x - min) / 4;
    track.style.transform = `translateX(${x}px)`;
    // The keypad holds still between Convert and Calculate, leaves with the calculator,
    // and morphs by how far Calculate has come in (--p, used by the .swiping styles).
    keysLayer.style.transform = `translateX(${Math.min(0, x + w)}px)`;
    keypad.style.setProperty('--p', String(Math.min(1, Math.max(0, -x / w))));
  });

  const endSwipe = (e: PointerEvent) => {
    if (!start || e.pointerId !== start.id) return;
    const s = start;
    start = null;
    if (!dragging) return;
    dragging = false;
    const dx = e.clientX - s.x;
    const velocity = dx / Math.max(1, e.timeStamp - s.t);
    const w = viewport.clientWidth;
    app.classList.remove('swiping');
    track.style.transform = keysLayer.style.transform = '';
    keypad.style.removeProperty('--p');
    suppressNextClick(viewport, e);
    const go = Math.abs(dx) > w * 0.25 || Math.abs(velocity) > 0.4;
    const next = index() + (dx < 0 ? 1 : -1);
    if (go && next >= 0 && next < TABS.length) {
      haptic();
      setTab(TABS[next]);
    }
  };
  viewport.addEventListener('pointerup', endSwipe);
  viewport.addEventListener('pointercancel', endSwipe);

  initPrecisionSheet();
  // Restore without animating.
  app.classList.add('instant');
  setTab(load<string>('tab', 'convert'));
  requestAnimationFrame(() => requestAnimationFrame(() => app.classList.remove('instant')));
  // Once every screen script has run, refresh so the peek is filled in (and the level starts).
  document.addEventListener('DOMContentLoaded', () => setTab(app.dataset.tab!));
</script>
