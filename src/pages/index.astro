---
import App from '../layouts/App.astro';
import Conversion from '../components/Conversion.astro';
import Calculator from '../components/Calculator.astro';
import { PRECISIONS } from '../lib/units';
---

<App title="Unit">
  <main class="app" data-tab="convert">
    <div class="tabs" role="tablist">
      <div class="tabs-thumb"></div>
      <button class="tab" role="tab" data-tab="convert" aria-selected="true" aria-controls="screen-convert">
        <span class="orb orb-sm orb-sunset"></span><span class="tab-label">Convert</span>
      </button>
      <button class="tab" role="tab" data-tab="calc" aria-selected="false" aria-controls="screen-calc">
        <span class="orb orb-sm orb-lagoon"></span><span class="tab-label">Calculate</span>
      </button>
    </div>

    <div class="viewport">
      <div class="track">
        <Conversion />
        <Calculator />
      </div>
    </div>
  </main>

  <div class="sheet-scrim"></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title" aria-hidden="true">
    <div class="sheet-grip-area"><div class="sheet-grip"></div></div>
    <h2 id="sheet-title">Precision</h2>
    <p>
      Fractions round to the nearest step and show in their simplest form. An arrow means the real value is a
      little larger <span class="rd up"><svg viewBox="0 0 10 10"><path d="M5 1.5 9 8H1z" /></svg></span> or
      smaller <span class="rd down"><svg viewBox="0 0 10 10"><path d="M5 8.5 9 2H1z" /></svg></span>
    </p>
    <div class="prec-grid" role="radiogroup">
      {PRECISIONS.map((p) => (
        <button class="prec-opt" role="radio" data-p={p} aria-checked="false">
          <span class="fr">1/{p}</span>
        </button>
      ))}
    </div>
  </div>
</App>

<script>
  import { haptic, shared, load, save, initPrecisionSheet, suppressNextClick } from '../lib/ui';

  const app = document.querySelector<HTMLElement>('.app')!;
  const track = app.querySelector<HTMLElement>('.track')!;
  const viewport = app.querySelector<HTMLElement>('.viewport')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const convLabel = document.querySelector<HTMLElement>('.tab[data-tab="convert"] .tab-label')!;

  function setTab(tab: string) {
    app.dataset.tab = tab;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === tab)));
    // While calculating, the Convert tab shows the last converted value as a peek.
    convLabel.innerHTML = tab === 'calc' && shared.convPeek ? shared.convPeek : 'Convert';
    save('tab', tab);
    document.dispatchEvent(new CustomEvent('tab:change', { detail: tab }));
  }

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      if (app.dataset.tab === t.dataset.tab) return;
      haptic();
      setTab(t.dataset.tab!);
    }),
  );

  /* ---------- Swipe between screens ---------- */

  let start: { x: number; y: number; t: number; id: number } | null = null;
  let dragging = false;

  viewport.addEventListener('pointerdown', (e) => {
    // Leave horizontally scrollable areas (long equation, long series line) alone.
    if ((e.target as HTMLElement).closest('.h-scroll.scrollable')) return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    start = { x: e.clientX, y: e.clientY, t: e.timeStamp, id: e.pointerId };
    dragging = false;
  });

  viewport.addEventListener('pointermove', (e) => {
    if (!start || e.pointerId !== start.id) return;
    const dx = e.clientX - start.x;
    const dy = e.clientY - start.y;
    if (!dragging) {
      if (Math.abs(dx) < 12 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
      dragging = true;
      viewport.setPointerCapture(e.pointerId);
      track.style.transition = 'none';
      app.classList.add('swiping');
    }
    const w = viewport.clientWidth;
    const base = app.dataset.tab === 'calc' ? -w : 0;
    let x = base + dx;
    // Rubber-band past either edge.
    if (x > 0) x /= 4;
    if (x < -w) x = -w + (x + w) / 4;
    track.style.transform = `translateX(${x}px)`;
  });

  const endSwipe = (e: PointerEvent) => {
    if (!start || e.pointerId !== start.id) return;
    const s = start;
    start = null;
    if (!dragging) return;
    dragging = false;
    const dx = e.clientX - s.x;
    const velocity = dx / Math.max(1, e.timeStamp - s.t);
    const w = viewport.clientWidth;
    track.style.transition = '';
    track.style.transform = '';
    app.classList.remove('swiping');
    suppressNextClick(viewport);
    const go = Math.abs(dx) > w * 0.25 || Math.abs(velocity) > 0.4;
    const next = dx < 0 ? 'calc' : 'convert';
    if (go && next !== app.dataset.tab) {
      haptic();
      setTab(next);
    }
  };
  viewport.addEventListener('pointerup', endSwipe);
  viewport.addEventListener('pointercancel', endSwipe);

  initPrecisionSheet();
  // Restore without animating.
  track.style.transition = 'none';
  setTab(load<string>('tab', 'convert') === 'calc' ? 'calc' : 'convert');
  requestAnimationFrame(() => requestAnimationFrame(() => (track.style.transition = '')));
  // Once every screen script has run, refresh so the peek is filled in.
  document.addEventListener('DOMContentLoaded', () => setTab(app.dataset.tab!));
</script>
